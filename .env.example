# automake-youtube — 환경변수 템플릿
# 실제 값을 채워서 .env 파일로 복사하세요 (cp .env.example .env)
# .env 는 git에 올라가지 않습니다.

# === Google YouTube Data API ===
# Google Cloud Console에서 OAuth 데스크톱 앱 클라이언트 생성 후 다운로드한 JSON 경로
YOUTUBE_CLIENT_SECRET_PATH=/Users/your-name/secrets/youtube/client_secret.json

# 첫 OAuth 인증 후 자동 생성될 토큰 파일 경로 (지금은 없어도 됨)
YOUTUBE_OAUTH_TOKEN_PATH=/Users/your-name/secrets/youtube/token.json

# === Google Gemini (Google AI Studio API key) ===
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=AIzaSy...your-key-here

# === 텔레그램 (주식 매매 알림) ===
# 선택 사항 — admin [📈 주식 매매 알림] 탭에서 UI로 설정하면 여기 없어도 됩니다.
# 봇 토큰: 텔레그램에서 @BotFather → /newbot
TELEGRAM_BOT_TOKEN=123456789:AAE...your-bot-token
# chat_id: 만든 봇에게 메시지 1번 보낸 뒤 탭의 [chat_id 자동 연결] 버튼으로 조회 가능
TELEGRAM_CHAT_ID=123456789

# ===================================================================
# === 주식 자동매매 (백테스트 단계에서는 아무것도 필요 없음) ===
# ===================================================================
# 백테스트는 네이버 일봉만 쓰므로 키 없이 돌아간다.
# 아래는 모의/실전 주문을 붙일 때부터 필요하다. 자세한 발급 절차는 docs/STOCK-TRADING.md

# --- 실행 모드 (안전장치) ---
# dry   = 주문 안 나감. 텔레그램 알림만 (기본값)
# paper = 한국투자증권 모의투자 계좌에 실제 주문
# live  = 실계좌에 실제 주문. 돈이 나간다
STOCK_MODE=dry

# 실계좌 주문은 이중 잠금이다 — STOCK_MODE=live 만으로는 안 열리고 이것도 true 여야 한다.
# 실수로 모드를 바꿔도 돈이 나가지 않게 하려는 장치이므로 기본값 false 를 유지할 것.
KIS_LIVE_TRADING_ENABLED=false

# --- 한국투자증권 (KIS Developers) ---
# https://apiportal.koreainvestment.com 에서 신청.
# ★ 모의용과 실전용 키가 별개다. 둘 다 발급받아 아래에 각각 채운다.
# 계좌번호는 10자리를 8자리(CANO) + 2자리(ACNT_PRDT_CD)로 쪼개서 넣는다. 뒤 2자리는 보통 01

# 모의투자용 (도메인 openapivts.koreainvestment.com:29443)
KIS_PAPER_APP_KEY=PS...your-paper-app-key
KIS_PAPER_APP_SECRET=your-paper-app-secret
KIS_PAPER_ACCOUNT=50123456
KIS_PAPER_ACCOUNT_PRODUCT=01

# 실전투자용 (도메인 openapi.koreainvestment.com:9443)
# ★ 모의에서 최소 4주 검증 전에는 채우지 말 것
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT=
KIS_LIVE_ACCOUNT_PRODUCT=01

# --- 토스증권 Open API ---
# 토스증권 PC 웹(WTS) 로그인 → 설정 → Open API 에서 발급 (토스앱 지문 승인)
# ★ 토스는 모의투자용 샌드박스가 없다. 발급 즉시 실계좌다 → 1주 단위 소액으로만 테스트할 것
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT=
# 토스는 모의계좌가 없다 — 실계좌다. 기본값 차단이고, 사람이 직접 true 로 바꾸기 전엔 주문이 나가지 않는다
TOSS_TRADING_ENABLED=false
