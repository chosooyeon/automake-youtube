{
  "$schema": "../shared/schemas/global.schema.json",
  "channel": {
    "name": "엄마지갑 (가칭)",
    "handle": "@mom_wallet",
    "language": "ko",
    "country": "KR",
    "niche": "임산부·예비 부모를 위한 정부지원금/복지/세제 혜택 정보 채널",
    "target_audience": "임신 중이거나 0~24개월 영유아를 둔 25~39세 부모, 첫째 출산이 많고 정보 탐색 의지는 있으나 행정용어에 약함",
    "value_prop": "정부 지원금 신청 시기·금액·서류를 ‘놓치지 않게’ 가장 빨리 정리해주는 채널"
  },
  "brand": {
    "tone": ["친근하지만 정확한", "행정용어를 풀어 쓰는", "단정·과장 금지"],
    "ban_words": [
      "광고", "협찬", "내돈내산",
      "100% 보장", "무조건 받는", "꿀팁대박",
      "정부가 주는 공돈", "안 받으면 손해"
    ],
    "must_words": ["2026년 기준", "신청 기한", "지원 대상", "지급 금액"],
    "intro_signature": "안녕하세요, 엄마지갑입니다. 오늘은 ___ 에 대해 정확하게 정리해드릴게요.",
    "outro_signature": "정보가 도움이 되셨다면 구독·알림설정 부탁드려요. 다음 영상에서 또 만나요.",
    "color_palette": ["#0F172A", "#FCA5A5", "#FFE4E6", "#F8FAFC"],
    "font_pair": { "title": "Pretendard Bold", "body": "Pretendard Regular" }
  },
  "video_defaults": {
    "format": "long",
    "duration_sec": 420,
    "aspect_ratio": "16:9",
    "resolution": "1920x1080",
    "fps": 30,
    "subtitle": { "enabled": true, "position": "bottom", "max_chars_per_line": 16 }
  },
  "models": {
    "writer": "claude-sonnet-4",
    "researcher": "claude-sonnet-4",
    "reviewer": "claude-opus-4",
    "image": "google:gemini-imagen-3 (나노바나나 / 웹UI 수동 가능)",
    "video": "none-for-this-channel",
    "tts": "capcut-builtin (한국어 내장 TTS 사용)"
  },
  "apis": {
    "youtube": {
      "client_secret_env": "YOUTUBE_CLIENT_SECRET_PATH",
      "oauth_token_env": "YOUTUBE_OAUTH_TOKEN_PATH",
      "upload_mode": "manual_confirm",
      "default_privacy": "private",
      "default_category_id": "27",
      "default_tags": ["임산부", "정부지원금", "출산지원금", "부모급여", "첫만남이용권", "육아", "복지로"]
    },
    "tts": {
      "provider": "capcut_builtin",
      "note": "외부 TTS API 호출하지 않음. 4번 봇은 씬 매핑 + SRT만 생성하고, CapCut에서 텍스트 읽기(TTS) 기능을 클릭으로 적용한다.",
      "voice_id_in_capcut": "여성_차분한 / 또는 사용자 선호",
      "speed": 1.0
    },
    "image": {
      "provider": "gemini_web_or_api",
      "api_key_env": "GEMINI_API_KEY",
      "size": "1280x720",
      "quality": "high",
      "note": "키가 없으면 5번/6번 봇은 프롬프트만 출력하고, 사용자가 gemini.google.com 에서 ‘이미지 만들어줘’로 직접 생성하도록 안내."
    },
    "video": {
      "provider": "none",
      "note": "이 채널은 영상 생성 모델 사용 안 함. CapCut 모션·줌·트랜지션으로 처리."
    },
    "search": {
      "provider": "web_search",
      "primary_sources": [
        "https://www.korea.kr",
        "https://www.mohw.go.kr",
        "https://www.bokjiro.go.kr",
        "https://www.childcare.go.kr",
        "https://www.gov.kr"
      ],
      "secondary_sources": [
        "https://www.yna.co.kr",
        "https://www.ibabynews.com",
        "https://www.hani.co.kr",
        "https://www.mt.co.kr"
      ],
      "youtube_research_queries": [
        "임산부 정부지원금 2026",
        "부모급여 인상 2026",
        "첫만남이용권 변경",
        "임산부 바우처 100만원",
        "출산지원금 받는법"
      ],
      "max_results": 20
    }
  },
  "capcut": {
    "template_path": "shared/templates/capcut_base.json",
    "fps": 30,
    "canvas": { "width": 1920, "height": 1080 },
    "mac_projects_dir": "~/Movies/CapCut/User Data/Projects/com.lveditor.draft",
    "place_project_json_into_capcut_dir": true
  },
  "thumbnails": {
    "count": 5,
    "template_path": "shared/templates/thumbnail_base.json",
    "size": "1280x720",
    "generation_mode": "prompts_only",
    "external_tool": "gemini_web (나노바나나)"
  },
  "human_gates": {
    "before_upload": true,
    "before_bulk_visual": true
  },
  "paths": {
    "projects_dir": "projects"
  },
  "fact_check": {
    "policy_topics_require_official_source": true,
    "min_official_sources": 2,
    "currency_year": 2026,
    "as_of_date": "2026-04-27"
  }
}
