  "scenes": [
    {
      "scene_id": "scene-001",
      "start_sec": 0,
      "end_sec": 15,
      "subtitle_cues": [
        {
          "start_sec": 0,
          "end_sec": 2.5,
          "text": "길에서 5만원을 주웠을 때와"
        },
        {
          "start_sec": 2.5,
          "end_sec": 5,
          "text": "5만원을 잃어버렸을 때 —"
        },
        {
          "start_sec": 5,
          "end_sec": 7.5,
          "text": "어느 쪽이 더 오래 남나요?"
        },
        {
          "start_sec": 7.5,
          "end_sec": 10,
          "text": "잃었을 때의 통증이 훨씬 깁니다."
        },
        {
          "start_sec": 10,
          "end_sec": 12.5,
          "text": "노벨상 받은 심리 법칙으로"
        },
        {
          "start_sec": 12.5,
          "end_sec": 15,
          "text": "그 이유를 풀어드릴게요."
        }
      ]
    },
    {
      "scene_id": "scene-002",
      "start_sec": 15,
      "end_sec": 45,
      "subtitle_cues": [
        {
          "start_sec": 15,
          "end_sec": 20,
          "text": "안녕하세요, 심리식탁입니다."
        },
        {
          "start_sec": 20,
          "end_sec": 25,
          "text": "오늘 주제는 '손해의 역설',"
        },
        {
          "start_sec": 25,
          "end_sec": 30,
          "text": "학술용어로 '손실 회피'입니다."
        },
        {
          "start_sec": 30,
          "end_sec": 35,
          "text": "노벨상 수상자 카너먼의 이론."
        },
        {
          "start_sec": 35,
          "end_sec": 40,
          "text": "소비·투자·다이어트·인간관계,"
        },
        {
          "start_sec": 40,
          "end_sec": 45,
          "text": "전부 다시 보이게 됩니다."
        }
      ]
    },
    {
      "scene_id": "scene-003",
      "start_sec": 45,
      "end_sec": 105,
      "subtitle_cues": [
        {
          "start_sec": 45,
          "end_sec": 50.45,
          "text": "1979년 카너먼과 트버스키 실험."
        },
        {
          "start_sec": 50.45,
          "end_sec": 55.91,
          "text": "도박 A: 100% 확률 100만원"
        },
        {
          "start_sec": 55.91,
          "end_sec": 61.36,
          "text": "도박 B: 50% 확률 250만원"
        },
        {
          "start_sec": 61.36,
          "end_sec": 66.82,
          "text": "수학상 B가 더 큰데도"
        },
        {
          "start_sec": 66.82,
          "end_sec": 72.27,
          "text": "80%가 A를 골랐습니다."
        },
        {
          "start_sec": 72.27,
          "end_sec": 77.73,
          "text": "이걸 '잃는 쪽'으로 뒤집으면"
        },
        {
          "start_sec": 77.73,
          "end_sec": 83.18,
          "text": "도박 C: 확정 100만원 손실"
        },
        {
          "start_sec": 83.18,
          "end_sec": 88.64,
          "text": "도박 D: 50%로 250만원 손실"
        },
        {
          "start_sec": 88.64,
          "end_sec": 94.09,
          "text": "이번엔 80%가 D를 골랐어요."
        },
        {
          "start_sec": 94.09,
          "end_sec": 99.55,
          "text": "같은 사람이, 같은 금액에서,"
        },
        {
          "start_sec": 99.55,
          "end_sec": 105,
          "text": "얻을 때 안전, 잃을 때 도박."
        }
      ]
    },
    {
      "scene_id": "scene-004",
      "start_sec": 105,
      "end_sec": 165,
      "subtitle_cues": [
        {
          "start_sec": 105,
          "end_sec": 111.67,
          "text": "손실의 무게 = 이득의 2.25배."
        },
        {
          "start_sec": 111.67,
          "end_sec": 118.33,
          "text": "만원 잃은 고통을 상쇄하려면"
        },
        {
          "start_sec": 118.33,
          "end_sec": 125,
          "text": "2만 2500원을 벌어야 본전."
        },
        {
          "start_sec": 125,
          "end_sec": 131.67,
          "text": "뇌 영상 연구도 같은 결과."
        },
        {
          "start_sec": 131.67,
          "end_sec": 138.33,
          "text": "돈을 잃을 때 편도체·섬엽이"
        },
        {
          "start_sec": 138.33,
          "end_sec": 145,
          "text": "더 강하게 활성화됩니다."
        },
        {
          "start_sec": 145,
          "end_sec": 151.67,
          "text": "원시시대, 손실은 곧 죽음."
        },
        {
          "start_sec": 151.67,
          "end_sec": 158.33,
          "text": "둔감한 조상은 살아남지 못함."
        },
        {
          "start_sec": 158.33,
          "end_sec": 165,
          "text": "우리는 예민한 자의 후손이죠."
        }
      ]
    },
    {
      "scene_id": "scene-005",
      "start_sec": 165,
      "end_sec": 225,
      "subtitle_cues": [
        {
          "start_sec": 165,
          "end_sec": 171.67,
          "text": "마트는 손실 회피의 최전선."
        },
        {
          "start_sec": 171.67,
          "end_sec": 178.33,
          "text": "'오늘만 30% 할인'은"
        },
        {
          "start_sec": 178.33,
          "end_sec": 185,
          "text": "단순 할인이 아니라"
        },
        {
          "start_sec": 185,
          "end_sec": 191.67,
          "text": "'놓치면 손해' 신호입니다."
        },
        {
          "start_sec": 191.67,
          "end_sec": 198.33,
          "text": "'1+1'도 같은 원리."
        },
        {
          "start_sec": 198.33,
          "end_sec": 205,
          "text": "하나만 사면 잃은 느낌."
        },
        {
          "start_sec": 205,
          "end_sec": 211.67,
          "text": "이커머스 '남은 재고 3개'도"
        },
        {
          "start_sec": 211.67,
          "end_sec": 218.33,
          "text": "재고 0 = 손실로 인식하도록"
        },
        {
          "start_sec": 218.33,
          "end_sec": 225,
          "text": "설계된 UI일 뿐입니다."
        }
      ]
    },
    {
      "scene_id": "scene-006",
      "start_sec": 225,
      "end_sec": 285,
      "subtitle_cues": [
        {
          "start_sec": 225,
          "end_sec": 232.5,
          "text": "투자에선 더 잔혹합니다."
        },
        {
          "start_sec": 232.5,
          "end_sec": 240,
          "text": "'본전 회복하면 팔아야지'"
        },
        {
          "start_sec": 240,
          "end_sec": 247.5,
          "text": "이게 처분 효과입니다."
        },
        {
          "start_sec": 247.5,
          "end_sec": 255,
          "text": "오른 건 너무 빨리 팔고"
        },
        {
          "start_sec": 255,
          "end_sec": 262.5,
          "text": "떨어진 건 너무 오래 들고."
        },
        {
          "start_sec": 262.5,
          "end_sec": 270,
          "text": "찰리 멍거 왈,"
        },
        {
          "start_sec": 270,
          "end_sec": 277.5,
          "text": "'투자 실력의 절반은 손절'."
        },
        {
          "start_sec": 277.5,
          "end_sec": 285,
          "text": "본능을 훈련으로 이겨야 합니다."
        }
      ]
    },
    {
      "scene_id": "scene-007",
      "start_sec": 285,
      "end_sec": 345,
      "subtitle_cues": [
        {
          "start_sec": 285,
          "end_sec": 291.67,
          "text": "다이어트가 어려운 이유?"
        },
        {
          "start_sec": 291.67,
          "end_sec": 298.33,
          "text": "디저트 못 먹는 건 손실,"
        },
        {
          "start_sec": 298.33,
          "end_sec": 305,
          "text": "건강은 멀리 있는 이득."
        },
        {
          "start_sec": 305,
          "end_sec": 311.67,
          "text": "2.25배 무거운 쪽이 이깁니다."
        },
        {
          "start_sec": 311.67,
          "end_sec": 318.33,
          "text": "그런데 거꾸로 쓰는 서비스가"
        },
        {
          "start_sec": 318.33,
          "end_sec": 325,
          "text": "미국에 있어요. StickK."
        },
        {
          "start_sec": 325,
          "end_sec": 331.67,
          "text": "실패하면 싫어하는 단체로"
        },
        {
          "start_sec": 331.67,
          "end_sec": 338.33,
          "text": "내 돈이 자동 송금됩니다."
        },
        {
          "start_sec": 338.33,
          "end_sec": 345,
          "text": "성공률 약 2배 상승."
        }
      ]
    },
    {
      "scene_id": "scene-008",
      "start_sec": 345,
      "end_sec": 405,
      "subtitle_cues": [
        {
          "start_sec": 345,
          "end_sec": 351.67,
          "text": "인간관계도 손실 회피."
        },
        {
          "start_sec": 351.67,
          "end_sec": 358.33,
          "text": "오래된 연인을 못 떠나는 건"
        },
        {
          "start_sec": 358.33,
          "end_sec": 365,
          "text": "투자한 시간이 손실로 느껴져서."
        },
        {
          "start_sec": 365,
          "end_sec": 371.67,
          "text": "이게 매몰비용 오류입니다."
        },
        {
          "start_sec": 371.67,
          "end_sec": 378.33,
          "text": "5년 다닌 직장이 아깝다는 이유로"
        },
        {
          "start_sec": 378.33,
          "end_sec": 385,
          "text": "또 다른 5년을 묶어두죠."
        },
        {
          "start_sec": 385,
          "end_sec": 391.67,
          "text": "단 하나의 점검 질문 —"
        },
        {
          "start_sec": 391.67,
          "end_sec": 398.33,
          "text": "오늘 처음 시작하는 사람이"
        },
        {
          "start_sec": 398.33,
          "end_sec": 405,
          "text": "그 자리에 들어가겠는가?"
        }
      ]
    },
    {
      "scene_id": "scene-009",
      "start_sec": 405,
      "end_sec": 450,
      "subtitle_cues": [
        {
          "start_sec": 405,
          "end_sec": 410.63,
          "text": "경영자도 같은 함정에."
        },
        {
          "start_sec": 410.63,
          "end_sec": 416.25,
          "text": "노키아·코닥·블록버스터 —"
        },
        {
          "start_sec": 416.25,
          "end_sec": 421.88,
          "text": "본업 잃는 두려움에 변화 X."
        },
        {
          "start_sec": 421.88,
          "end_sec": 427.5,
          "text": "정치도 똑같아요."
        },
        {
          "start_sec": 427.5,
          "end_sec": 433.13,
          "text": "'얻는 정책'은 미지근하고"
        },
        {
          "start_sec": 433.13,
          "end_sec": 438.75,
          "text": "'안 하면 잃을 정책'은 강함."
        },
        {
          "start_sec": 438.75,
          "end_sec": 444.38,
          "text": "광고가 '놓치지 마세요'로"
        },
        {
          "start_sec": 444.38,
          "end_sec": 450,
          "text": "끝나는 진짜 이유입니다."
        }
      ]
    },
    {
      "scene_id": "scene-010",
      "start_sec": 450,
      "end_sec": 510,
      "subtitle_cues": [
        {
          "start_sec": 450,
          "end_sec": 457.5,
          "text": "활용법 3가지."
        },
        {
          "start_sec": 457.5,
          "end_sec": 465,
          "text": "1) 결정은 제로 베이스로."
        },
        {
          "start_sec": 465,
          "end_sec": 472.5,
          "text": "오늘 새로 시작한다면?"
        },
        {
          "start_sec": 472.5,
          "end_sec": 480,
          "text": "2) 나에게는 손실 형태 동기."
        },
        {
          "start_sec": 480,
          "end_sec": 487.5,
          "text": "'운동 안 하면 약값 30만원'."
        },
        {
          "start_sec": 487.5,
          "end_sec": 495,
          "text": "3) 남에게는 '잃을 위험'."
        },
        {
          "start_sec": 495,
          "end_sec": 502.5,
          "text": "왜 해야 하는가가 아니라"
        },
        {
          "start_sec": 502.5,
          "end_sec": 510,
          "text": "안 하면 무엇을 잃는가."
        }
      ]
    },
    {
      "scene_id": "scene-011",
      "start_sec": 510,
      "end_sec": 555,
      "subtitle_cues": [
        {
          "start_sec": 510,
          "end_sec": 516.43,
          "text": "어두운 면도 있어요."
        },
        {
          "start_sec": 516.43,
          "end_sec": 522.86,
          "text": "도박 중독은 회복 본능."
        },
        {
          "start_sec": 522.86,
          "end_sec": 529.29,
          "text": "공포 마케팅도 같은 원리."
        },
        {
          "start_sec": 529.29,
          "end_sec": 535.71,
          "text": "정치적 공포 동원도 마찬가지."
        },
        {
          "start_sec": 535.71,
          "end_sec": 542.14,
          "text": "알고 쓰면 도구,"
        },
        {
          "start_sec": 542.14,
          "end_sec": 548.57,
          "text": "모르고 당하면 함정 —"
        },
        {
          "start_sec": 548.57,
          "end_sec": 555,
          "text": "그게 손실 회피입니다."
        }
      ]
    },
    {
      "scene_id": "scene-012",
      "start_sec": 555,
      "end_sec": 585,
      "subtitle_cues": [
        {
          "start_sec": 555,
          "end_sec": 559.29,
          "text": "오늘의 3줄 요약."
        },
        {
          "start_sec": 559.29,
          "end_sec": 563.57,
          "text": "1) 손실 = 이득 × 2.25"
        },
        {
          "start_sec": 563.57,
          "end_sec": 567.86,
          "text": "잃는 쪽에 더 예민한 뇌."
        },
        {
          "start_sec": 567.86,
          "end_sec": 572.14,
          "text": "2) 매몰비용·처분 효과·공포 마케팅"
        },
        {
          "start_sec": 572.14,
          "end_sec": 576.43,
          "text": "= 비합리 결정의 정체."
        },
        {
          "start_sec": 576.43,
          "end_sec": 580.71,
          "text": "3) 제로베이스·손실형 동기·"
        },
        {
          "start_sec": 580.71,
          "end_sec": 585,
          "text": "잃을 위험 중심 설득."
        }
      ]
    },
    {
      "scene_id": "scene-013",
      "start_sec": 585,
      "end_sec": 600,
      "subtitle_cues": [
        {
          "start_sec": 585,
          "end_sec": 587.5,
          "text": "오늘 '잃기 싫어서' 한 결정,"
        },
        {
          "start_sec": 587.5,
          "end_sec": 590,
          "text": "댓글로 한 줄 남겨주세요."
        },
        {
          "start_sec": 590,
          "end_sec": 592.5,
          "text": "다음 영상은 설득의 심리학"
        },
        {
          "start_sec": 592.5,
          "end_sec": 595,
          "text": "6가지 법칙 편입니다."
        },
        {
          "start_sec": 595,
          "end_sec": 597.5,
          "text": "알림 켜두시고,"
        },
        {
          "start_sec": 597.5,
          "end_sec": 600,
          "text": "다음 영상에서 만나요."
        }
      ]
    }
