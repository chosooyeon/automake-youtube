{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "global.schema.json",
  "title": "Global Config",
  "type": "object",
  "required": ["channel", "brand", "video_defaults", "models", "apis"],
  "properties": {
    "channel": {
      "type": "object",
      "required": ["name", "language", "niche"],
      "properties": {
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "language": { "type": "string" },
        "country": { "type": "string" },
        "niche": { "type": "string" },
        "target_audience": { "type": "string" },
        "value_prop": { "type": "string" }
      }
    },
    "brand": {
      "type": "object",
      "properties": {
        "tone": { "type": "array", "items": { "type": "string" } },
        "ban_words": { "type": "array", "items": { "type": "string" } },
        "must_words": { "type": "array", "items": { "type": "string" } },
        "intro_signature": { "type": "string" },
        "outro_signature": { "type": "string" },
        "color_palette": { "type": "array", "items": { "type": "string" } },
        "font_pair": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "body": { "type": "string" }
          }
        }
      }
    },
    "video_defaults": {
      "type": "object",
      "properties": {
        "format": { "type": "string", "enum": ["short", "long"] },
        "duration_sec": { "type": "integer" },
        "aspect_ratio": { "type": "string" },
        "resolution": { "type": "string" },
        "fps": { "type": "integer" }
      }
    },
    "models": { "type": "object" },
    "apis": { "type": "object" },
    "capcut": { "type": "object" },
    "thumbnails": { "type": "object" },
    "human_gates": { "type": "object" },
    "paths": { "type": "object" }
  }
}
