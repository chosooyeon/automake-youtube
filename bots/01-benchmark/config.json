{
  "id": "01-benchmark",
  "name": "벤치마킹 봇",
  "purpose": "주제 키워드로 유튜브 레퍼런스 영상을 수집하고 패턴을 분석한다.",
  "model": {
    "use": "researcher",
    "fallback": "writer"
  },
  "input_schema": null,
  "output_schema": "shared/schemas/01-benchmark.schema.json",
  "params": {
    "min_references": 7,
    "max_references": 12,
    "lookback_days": 365,
    "sort_by": "viewCount",
    "regions": [
      "KR"
    ],
    "min_views": 50000,
    "include_shorts": false,
    "search_strategies": [
      "정확한 주제 키워드",
      "주제의 상위 카테고리 키워드",
      "타겟 페르소나가 검색할 만한 질문형 키워드",
      "경쟁 채널 핸들 검색"
    ]
  },
  "analysis": {
    "axes": [
      "훅(0~7초) 패턴",
      "영상 구조",
      "제목 공식",
      "썸네일 비주얼/카피 공식",
      "길이/리텐션 추정",
      "차별화 기회"
    ],
    "deliverables": [
      "references[] 각 항목의 hook_first_15s, structure, why_it_works, weakness",
      "synthesis: winning_patterns, title_formulas, hook_formulas, structure_recommendation, differentiation_opportunities",
      "synthesis: signal_metrics (수치형 가이드라인)"
    ],
    "signal_metrics_to_extract": {
      "_comment": "각 레퍼런스에서 가능한 한 측정/추정해서 references[i].signals 에 기록.",
      "fields": [
        "video_length_sec",
        "intro_length_sec",
        "first_hook_sec",
        "subtitle_present",
        "midroll_ad_sec_estimates",
        "thumbnail_dominant_colors",
        "thumbnail_has_big_number",
        "thumbnail_has_face",
        "title_char_count",
        "title_has_year",
        "title_has_number",
        "comments_top3_themes"
      ]
    },
    "synthesis_metric_targets": {
      "_comment": "synthesis.signal_metrics 에 평균/중앙값을 채워서, 우리 영상 길이/인트로 길이 결정에 쓴다.",
      "fields": [
        "avg_video_length_sec",
        "median_video_length_sec",
        "avg_intro_length_sec",
        "thumbnail_color_palette_top3",
        "title_avg_char_count",
        "title_pct_with_number",
        "midroll_ad_typical_seconds"
      ]
    }
  },
  "tools_allowed": [
    "WebSearch",
    "WebFetch",
    "Read",
    "Write(./projects/{slug}/01-benchmark/**)"
  ],
  "model_tier": "opus",
  "_model_tier_reason": "벤치마크 분석 = 패턴 추출 + 차별화 기회 추론 = 전략적 판단. opus(4.7) 사용.",
  "max_turns": 40
}
